          <span class="toolbar-hint">↵ send · ⇧↵ newline</span>
          <button class="ibutton" id="mic-btn" title="Voice input">
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" width="13" height="13">
              <rect x="5" y="1" width="6" height="9" rx="3"/>
              <path d="M2 8a6 6 0 0 0 12 0M8 14v2"/>
            </svg>
          </button>
          <button class="btn-send" id="send-btn">
            Send
            <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" width="10" height="10">
              <path d="M2 10 L10 2 M4 2 H10 V8"/>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </main>
</div>

<script>
// ── State ──────────────────────────────────────────────────────────────────
const CHATS_KEY = 'mia_chats_v3';
const GRAPH_KEY = 'mia_graph_v3';
const VOICE_LANGS = { en:'en-US', es:'es-US', ht:'fr-HT' };
let state = {
  chats:     JSON.parse(localStorage.getItem(CHATS_KEY) || '[]'),
  graphData: JSON.parse(localStorage.getItem(GRAPH_KEY) || '{"nodes":[],"edges":[]}'),
  lang:      'en',
  voiceOn:   true,
  loading:   false,
};
let recognition = null;
let graphInst   = null;

// ── DOM ────────────────────────────────────────────────────────────────────
const $ = id => document.getElementById(id);
const msgsEl    = $('messages');
const emptyEl   = $('empty-state');
const inputEl   = $('mia-input');
const sendBtn   = $('send-btn');
const loadBar   = $('load-bar');
const intentLbl = $('intent-label');
const nodesLbl  = $('graph-nodes');
const edgesLbl  = $('graph-edges');

// ── Boot ───────────────────────────────────────────────────────────────────
function boot() {
  if (state.chats.length) {
    emptyEl.style.display = 'none';
    state.chats.forEach(c => renderMsg(c, false));
  }
  updateGraphStats();
  initGraph();
  syncVoiceButtons();
}

// ── Render message ─────────────────────────────────────────────────────────
function renderMsg(chat, scroll = true) {
  emptyEl.style.display = 'none';
  const isMe = chat.from === 'me';
  const row  = document.createElement('div');
  row.className = 'msg-row gap';

  const inner = document.createElement('div');
  inner.className = 'msg-inner' + (isMe ? ' me' : '');

  // Avatar
  const av = document.createElement('div');
  av.className = isMe ? 'msg-avatar-me' : 'msg-avatar';
  if (!isMe) {
    av.innerHTML = '<img src="/assets/mia.jpg" alt="Mia" onerror="this.style.display=\'none\';this.parentNode.style.background=\'#F0644A\'">';
  } else {
    av.textContent = '👤';
  }
  inner.appendChild(av);

  // Body
  const body = document.createElement('div');
  body.className = 'msg-body';

  const bubble = document.createElement('div');
  bubble.className = 'bubble ' + (isMe ? 'bubble-me' : 'bubble-mia');
  bubble.textContent = chat.message;
  body.appendChild(bubble);

  if (!isMe) {
    if (chat.sources && chat.sources.length) {
      const srcs = document.createElement('div');
      srcs.className = 'msg-sources';
      chat.sources.forEach(s => {
        const a = document.createElement('a');
        a.className = 'src-chip'; a.href = s.url; a.target = '_blank'; a.rel = 'noopener';
        a.title = s.description || ''; a.innerHTML = `<span class="dot">●</span>${s.title}`;
        srcs.appendChild(a);
      });
      body.appendChild(srcs);
    }
    if (chat.quickLinks && chat.quickLinks.length) {
      const qls = document.createElement('div'); qls.className = 'msg-qlinks';
      chat.quickLinks.forEach(q => {
        const a = document.createElement('a');
        a.className = 'ql-btn'; a.href = q.url; a.target = '_blank'; a.rel = 'noopener';
        a.innerHTML = `<svg class="ql-arrow" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M2 10 L10 2 M4 2 H10 V8"/></svg>${q.label}`;
        qls.appendChild(a);
      });
      body.appendChild(qls);
    }
  }

  inner.appendChild(body);
  row.appendChild(inner);
  msgsEl.appendChild(row);
  if (scroll) row.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
}

// ── Typing indicator ───────────────────────────────────────────────────────
let typingEl = null;
function showTyping() {
  typingEl = document.createElement('div'); typingEl.className = 'typing-row';
  typingEl.innerHTML = `<div class="typing-inner"><div class="msg-avatar"><img src="/assets/mia.jpg" alt="" onerror="this.style.display='none';this.parentNode.style.background='#F0644A'"></div><div class="typing-bubble"><div class="td"></div><div class="td"></div><div class="td"></div></div></div>`;
  msgsEl.appendChild(typingEl); typingEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
}
function hideTyping() { typingEl?.remove(); typingEl = null; }

// ── Send ───────────────────────────────────────────────────────────────────
async function send() {
  const text = inputEl.value.trim();
  if (!text || state.loading) return;
  inputEl.value = ''; autoGrow();
  state.loading = true; sendBtn.disabled = true; loadBar.classList.add('on');

  const meMsg = { from: 'me', message: text };
  state.chats.push(meMsg); renderMsg(meMsg); showTyping();

  try {
    const res  = await fetch('/api/chat', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ input: { currentMessage: text } })
    });
    const data = await res.json();
    hideTyping();

    const miaMsg = {
      from:       'mia',
      message:    data.response?.content || data.response || '🌴',
      sources:    data.sources    || [],
      quickLinks: data.quickLinks || [],
      language:   data.language   || 'en',
    };
    state.chats.push(miaMsg);
    localStorage.setItem(CHATS_KEY, JSON.stringify(state.chats));
    renderMsg(miaMsg);
    setLang(miaMsg.language);
    if (data.intent) intentLbl.textContent = data.intent.replace(/_/g, ' ');

    if (data.entities?.length) {
      data.entities.forEach(e => graphInst?.addNode(e.id, e.label, e.type));
      data.relations?.forEach(r => graphInst?.addEdge(r.source, r.target, r.relation));
      state.graphData.nodes.push(...(data.entities || []));
      state.graphData.edges.push(...(data.relations || []));
      localStorage.setItem(GRAPH_KEY, JSON.stringify(state.graphData));
      updateGraphStats();
    }

    if (state.voiceOn && window.speechSynthesis) {
      const clean = miaMsg.message.replace(/https?:\/\/\S+/g, '').replace(/[*_#\[\]]/g, '');
      const utt = new SpeechSynthesisUtterance(clean);
      utt.lang = VOICE_LANGS[miaMsg.language] || 'en-US'; utt.pitch = 1.05; utt.rate = 0.97;
      const voices = window.speechSynthesis.getVoices();
      const v = voices.find(v => v.lang.startsWith(utt.lang.split('-')[0]) && /samantha|karen|moira|allison|zoe|monica/i.test(v.name));
      if (v) utt.voice = v;
      window.speechSynthesis.speak(utt);
    }
  } catch {
    hideTyping();
    const err = { from: 'mia', message: 'Something went wrong — please try again.', sources: [], quickLinks: [] };
    state.chats.push(err); renderMsg(err);
  } finally {
    state.loading = false; sendBtn.disabled = false; loadBar.classList.remove('on');
  }
}

// ── Lang ───────────────────────────────────────────────────────────────────
function setLang(l) {
  state.lang = l;
  ['en','es','ht'].forEach(c => $(`lang-${c}`)?.classList.toggle('active', c === l));
}

// ── Voice ──────────────────────────────────────────────────────────────────
function syncVoiceButtons() {
  const label = state.voiceOn ? '🔊 Voice on' : '🔇 Voice off';
  $('voice-toggle').textContent = label;
  const tb = $('topbar-voice');
  if (tb) { tb.textContent = state.voiceOn ? '🔊' : '🔇'; tb.classList.toggle('muted', !state.voiceOn); }
}
function toggleVoice() {
  state.voiceOn = !state.voiceOn;
  if (!state.voiceOn) window.speechSynthesis?.cancel();
  syncVoiceButtons();
}
$('voice-toggle').addEventListener('click', toggleVoice);
$('topbar-voice')?.addEventListener('click', toggleVoice);

// ── Mic ────────────────────────────────────────────────────────────────────
function toggleMic() {
  const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
  if (!SR) { alert('Voice input not supported in this browser'); return; }
  if (recognition) { recognition.stop(); return; }
  recognition = new SR();
  recognition.continuous = false; recognition.interimResults = false;
  recognition.onresult = e => { inputEl.value = e.results[0][0].transcript; autoGrow(); };
  recognition.onend = () => {
    recognition = null;
    $('mic-btn')?.classList.remove('active');
    $('topbar-mic')?.classList.remove('active');
  };
  recognition.start();
  $('mic-btn')?.classList.add('active');
  $('topbar-mic')?.classList.add('active');
}
$('mic-btn')?.addEventListener('click', toggleMic);
$('topbar-mic')?.addEventListener('click', toggleMic);

// ── Clear ──────────────────────────────────────────────────────────────────
$('clear-btn').addEventListener('click', () => {
  if (!confirm('Clear all conversation history and knowledge graph?')) return;
  state.chats = []; state.graphData = { nodes: [], edges: [] };
  localStorage.removeItem(CHATS_KEY); localStorage.removeItem(GRAPH_KEY);
  msgsEl.querySelectorAll('.msg-row, .typing-row').forEach(el => el.remove());
  emptyEl.style.display = 'flex';
  updateGraphStats();
  if (graphInst) { graphInst.nodes = []; graphInst.edges = []; }
  intentLbl.textContent = 'Miami-Dade AI Guide';
  setLang('en');
});

// ── Input auto-grow ────────────────────────────────────────────────────────
function autoGrow() {
  inputEl.style.height = 'auto';
  inputEl.style.height = Math.min(inputEl.scrollHeight, 130) + 'px';
}
inputEl.addEventListener('input', autoGrow);
inputEl.addEventListener('keydown', e => { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); send(); } });
sendBtn.addEventListener('click', send);

// ── Public API for starter buttons ─────────────────────────────────────────
window.mia = { prompt(text) { inputEl.value = text; autoGrow(); inputEl.focus(); } };

// ── Graph stats ────────────────────────────────────────────────────────────
function updateGraphStats() {
  const seen = new Set(); state.graphData.nodes.forEach(n => seen.add(n.id));
  nodesLbl.textContent = seen.size + ' nodes';
  edgesLbl.textContent = state.graphData.edges.length + ' edges';
}

// ── Knowledge Graph ────────────────────────────────────────────────────────
class MiaGraph {
  constructor(canvas) {
    this.canvas = canvas; this.ctx = canvas.getContext('2d');
    this.nodes = []; this.edges = [];
    this._resize(); window.addEventListener('resize', () => this._resize());
  }
  _resize() {
    const r = this.canvas.getBoundingClientRect();
    this.canvas.width = r.width || 192; this.canvas.height = r.height || 118;
  }
  addNode(id, label, type) {
    if (this.nodes.find(n => n.id === id)) return;
    const C = { place:'#F0644A', service:'#38B4C8', department:'#9b59b6', topic:'#3DBE6E', dataset:'#F5A462', person:'#E8C96D' };
    this.nodes.push({ id, label, type, color: C[type]||'#38B4C8',
      x: this.canvas.width*(0.2+Math.random()*0.6), y: this.canvas.height*(0.2+Math.random()*0.6),
      vx:0, vy:0, pulse: Math.random()*Math.PI*2 });
    if (!this._running) this._start();
  }
  addEdge(s, t, r) {
    if (!s||!t||this.edges.find(e=>e.s===s&&e.t===t)) return;
    this.edges.push({s,t,r});
  }
  _tick() {
    const N=this.nodes, W=this.canvas.width, H=this.canvas.height;
    for(let i=0;i<N.length;i++) for(let j=i+1;j<N.length;j++){
      const a=N[i],b=N[j],dx=b.x-a.x,dy=b.y-a.y,d=Math.sqrt(dx*dx+dy*dy)||1;
      const f=Math.min(2000/(d*d),2.5);
      a.vx-=f*dx/d; a.vy-=f*dy/d; b.vx+=f*dx/d; b.vy+=f*dy/d;
    }
    for(const e of this.edges){
      const a=N.find(n=>n.id===e.s), b=N.find(n=>n.id===e.t);
      if(!a||!b) continue;
      const dx=b.x-a.x,dy=b.y-a.y,d=Math.sqrt(dx*dx+dy*dy)||1,f=(d-80)*0.007;
      a.vx+=f*dx/d; a.vy+=f*dy/d; b.vx-=f*dx/d; b.vy-=f*dy/d;
    }
    for(const n of N){
      n.vx+=(W/2-n.x)*0.002; n.vy+=(H/2-n.y)*0.002;
      n.vx*=0.88; n.vy*=0.88; n.x+=n.vx; n.y+=n.vy;
      n.x=Math.max(14,Math.min(W-14,n.x)); n.y=Math.max(10,Math.min(H-10,n.y));
      n.pulse+=0.035;
    }
  }
  _draw() {
    const {ctx}=this;
    ctx.clearRect(0,0,this.canvas.width,this.canvas.height);
    for(const e of this.edges){
      const a=this.nodes.find(n=>n.id===e.s), b=this.nodes.find(n=>n.id===e.t);
      if(!a||!b) continue;
      ctx.beginPath(); ctx.moveTo(a.x,a.y); ctx.lineTo(b.x,b.y);
      const g=ctx.createLinearGradient(a.x,a.y,b.x,b.y);
      g.addColorStop(0,a.color+'50'); g.addColorStop(1,b.color+'50');
      ctx.strokeStyle=g; ctx.lineWidth=1; ctx.stroke();
    }
    for(const n of this.nodes){
      const r=9+Math.sin(n.pulse)*1.5;
      const gw=ctx.createRadialGradient(n.x,n.y,0,n.x,n.y,r*2.5);
      gw.addColorStop(0,n.color+'45'); gw.addColorStop(1,'transparent');
      ctx.beginPath(); ctx.arc(n.x,n.y,r*2.5,0,Math.PI*2); ctx.fillStyle=gw; ctx.fill();
      ctx.beginPath(); ctx.arc(n.x,n.y,r,0,Math.PI*2); ctx.fillStyle=n.color+'22'; ctx.fill();
      ctx.strokeStyle=n.color+'99'; ctx.lineWidth=1; ctx.stroke();
      ctx.fillStyle='rgba(240,237,232,0.65)'; ctx.font='7px system-ui';
      ctx.textAlign='center'; ctx.textBaseline='top';
      ctx.fillText(n.label.slice(0,13), n.x, n.y+r+2);
    }
  }
  _start() {
    this._running = true;
    const t=()=>{ if(this.nodes.length){this._tick();this._draw();} requestAnimationFrame(t); };
    t();
  }
}

function initGraph() {
  const c = $('mia-graph-canvas'); if (!c) return;
  graphInst = new MiaGraph(c);
  state.graphData.nodes.forEach(n => graphInst.addNode(n.id, n.label, n.type));
  state.graphData.edges.forEach(e => graphInst.addEdge(e.s||e.source, e.t||e.target, e.r||e.relation));
}

boot();
</script>
