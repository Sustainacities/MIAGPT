<style>
/* ─── Token system ─────────────────────────────────────────────────────────── */
:root {
  --bg:          #0B0A12;
  --surface:     #141320;
  --surface-2:   #1C1B2A;
  --surface-3:   #242233;
  --border:      rgba(255,255,255,0.06);
  --border-2:    rgba(255,255,255,0.10);
  --border-acc:  rgba(240,100,74,0.22);
  --ink:         #F0EDE8;
  --ink-2:       #8A8492;
  --ink-3:       #4E4B58;
  --accent:      #F0644A;
  --accent-dim:  rgba(240,100,74,0.13);
  --teal:        #38B4C8;
  --teal-dim:    rgba(56,180,200,0.09);
  --ok:          #3DBE6E;
  --r-sm: 8px; --r-md: 12px; --r-lg: 16px; --r-xl: 20px;
}
@media (prefers-color-scheme: light) { :root {
  --bg:#F5F3EF; --surface:#FFFFFF; --surface-2:#F0ECE7; --surface-3:#E8E3DD;
  --border:rgba(0,0,0,0.07); --border-2:rgba(0,0,0,0.11); --border-acc:rgba(240,100,74,0.25);
  --ink:#18161F; --ink-2:#6A6774; --ink-3:#AAA6B4;
}}
:root[data-theme="dark"]  {
  --bg:#0B0A12; --surface:#141320; --surface-2:#1C1B2A; --surface-3:#242233;
  --border:rgba(255,255,255,0.06); --border-2:rgba(255,255,255,0.10); --border-acc:rgba(240,100,74,0.22);
  --ink:#F0EDE8; --ink-2:#8A8492; --ink-3:#4E4B58;
}
:root[data-theme="light"] {
  --bg:#F5F3EF; --surface:#FFFFFF; --surface-2:#F0ECE7; --surface-3:#E8E3DD;
  --border:rgba(0,0,0,0.07); --border-2:rgba(0,0,0,0.11); --border-acc:rgba(240,100,74,0.25);
  --ink:#18161F; --ink-2:#6A6774; --ink-3:#AAA6B4;
}

/* ─── Reset ────────────────────────────────────────────────────────────────── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html, body { height: 100%; overflow: hidden; }
body {
  font-family: -apple-system, BlinkMacSystemFont, 'Inter', 'Segoe UI', system-ui, sans-serif;
  font-size: 15px; line-height: 1.6;
  background: var(--bg); color: var(--ink);
  -webkit-font-smoothing: antialiased;
}
a { color: inherit; }
button { font-family: inherit; cursor: pointer; border: none; background: none; }
textarea { font-family: inherit; }

/* ─── App shell ─────────────────────────────────────────────────────────────── */
.app { display: grid; grid-template-columns: 228px 1fr; height: 100vh; overflow: hidden; }

/* ─── Sidebar ───────────────────────────────────────────────────────────────── */
.sidebar {
  background: var(--surface);
  border-right: 1px solid var(--border);
  display: flex; flex-direction: column; overflow: hidden;
}

.sidebar-brand { padding: 20px 18px 18px; border-bottom: 1px solid var(--border); }

.mia-ident { display: flex; align-items: center; gap: 11px; }

/* Sunrise halo — the one animated element */
.avatar-wrap { position: relative; width: 40px; height: 40px; flex-shrink: 0; }
.halo {
  position: absolute; inset: -3px; border-radius: 50%;
  background: conic-gradient(from 0deg, #F0644A, #F5A462, #E8C96D, #F5A462, #F0644A);
  animation: halo-turn 10s linear infinite;
}
@keyframes halo-turn { to { transform: rotate(360deg); } }
@media (prefers-reduced-motion: reduce) { .halo { animation: none; } }
.avatar-inner { position: absolute; inset: 2.5px; border-radius: 50%; overflow: hidden; background: var(--bg); }
.avatar-inner img { width: 100%; height: 100%; object-fit: cover; filter: saturate(0.88); display: block; }

.mia-nameblock .name { font-size: 14px; font-weight: 700; letter-spacing: 0.03em; color: var(--ink); line-height: 1.2; }
.mia-nameblock .role { font-size: 10px; letter-spacing: 0.09em; text-transform: uppercase; color: var(--ink-3); margin-top: 2px; }

.online-row { display: flex; align-items: center; gap: 7px; margin-top: 13px; }
.online-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--ok); box-shadow: 0 0 5px var(--ok); }
.online-label { font-size: 10px; letter-spacing: 0.07em; text-transform: uppercase; color: var(--ink-3); }

/* Language tabs */
.lang-row { display: flex; gap: 4px; padding: 12px 18px; border-bottom: 1px solid var(--border); }
.lang-btn {
  flex: 1; display: flex; flex-direction: column; align-items: center; gap: 2px;
  padding: 7px 4px; border-radius: var(--r-sm);
  border: 1px solid transparent; background: transparent; color: var(--ink-3);
  transition: all 0.18s;
}
.lang-btn .flag { font-size: 15px; line-height: 1; }
.lang-btn .code { font-size: 9px; letter-spacing: 0.08em; text-transform: uppercase; font-variant-numeric: tabular-nums; }
.lang-btn.active { background: var(--accent-dim); border-color: var(--border-acc); color: var(--accent); }

/* Sidebar sections */
.s-section { padding: 14px 18px; border-bottom: 1px solid var(--border); }
.s-label {
  font-size: 9.5px; letter-spacing: 0.11em; text-transform: uppercase;
  color: var(--ink-3); font-weight: 600; margin-bottom: 8px;
  display: flex; justify-content: space-between; align-items: center;
}
.s-label-action {
  font-size: 9.5px; letter-spacing: 0.07em; text-transform: uppercase;
  color: var(--ink-3); cursor: pointer; transition: color 0.15s;
  font-family: 'SF Mono', Consolas, monospace;
}
.s-label-action:hover { color: var(--teal); }

/* Knowledge graph */
.graph-frame { background: var(--bg); border: 1px solid var(--border); border-radius: var(--r-md); overflow: hidden; }
#mia-graph-canvas { width: 100%; height: 118px; display: block; }
.graph-meta {
  display: flex; justify-content: space-between;
  padding: 5px 10px; border-top: 1px solid var(--border);
  font-size: 9.5px; color: var(--ink-3);
  font-family: 'SF Mono', 'Cascadia Code', Consolas, monospace;
  font-variant-numeric: tabular-nums; letter-spacing: 0.04em;
}

/* Ecosystem links */
.eco-link {
  display: flex; align-items: center; gap: 9px;
  padding: 6px 2px; font-size: 12px; color: var(--ink-2);
  text-decoration: none; transition: color 0.15s;
}
.eco-link:hover { color: var(--ink); }
.eco-icon {
  width: 18px; height: 18px; background: var(--surface-2); border: 1px solid var(--border);
  border-radius: 5px; display: flex; align-items: center; justify-content: center;
  font-size: 10px; flex-shrink: 0;
}

/* Sidebar footer */
.sidebar-footer {
  margin-top: auto; padding: 12px 18px; border-top: 1px solid var(--border);
  display: flex; justify-content: space-between; align-items: center;
}
.footer-btn { font-size: 10px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-3); transition: color 0.15s; }
.footer-btn:hover { color: var(--ink-2); }
.footer-btn.danger:hover { color: #e05050; }

/* ─── Main ──────────────────────────────────────────────────────────────────── */
.main { display: flex; flex-direction: column; overflow: hidden; position: relative; background: var(--bg); }

.chat-topbar {
  flex-shrink: 0; height: 52px; border-bottom: 1px solid var(--border);
  display: flex; align-items: center; padding: 0 24px; gap: 8px;
}
.topbar-title { font-size: 13px; font-weight: 600; color: var(--ink-2); letter-spacing: 0.02em; }
.topbar-sep { color: var(--ink-3); }
.topbar-intent {
  font-size: 10px; letter-spacing: 0.09em; text-transform: uppercase;
  color: var(--ink-3); font-family: 'SF Mono', Consolas, monospace;
}
.topbar-actions { margin-left: auto; display: flex; gap: 6px; }
.topbar-btn {
  width: 28px; height: 28px; border-radius: var(--r-sm);
  border: 1px solid var(--border); background: transparent; color: var(--ink-3);
  display: flex; align-items: center; justify-content: center;
  font-size: 13px; cursor: pointer; transition: all 0.15s;
}
.topbar-btn:hover { background: var(--surface-2); color: var(--ink-2); }
.topbar-btn.muted { color: var(--accent); background: var(--accent-dim); border-color: var(--border-acc); }

/* Loading bar */
.load-bar {
  position: absolute; top: 52px; left: 0; right: 0; height: 1px;
  background: linear-gradient(90deg, transparent 0%, var(--accent) 40%, var(--teal) 60%, transparent 100%);
  background-size: 200% 100%;
  animation: lscan 1.1s ease-in-out infinite;
  opacity: 0; transition: opacity 0.2s; pointer-events: none; z-index: 10;
}
.load-bar.on { opacity: 1; }
@keyframes lscan { 0% { background-position: 200% 0; } 100% { background-position: -100% 0; } }

/* Messages */
.messages { flex: 1; overflow-y: auto; padding: 24px 0 8px; }
.messages::-webkit-scrollbar { width: 3px; }
.messages::-webkit-scrollbar-track { background: transparent; }
.messages::-webkit-scrollbar-thumb { background: var(--surface-3); border-radius: 2px; }

.msg-row { padding: 3px 24px; }
.msg-row.gap { margin-top: 14px; }
.msg-inner { display: flex; gap: 10px; }
.msg-inner.me { flex-direction: row-reverse; }

.msg-avatar { width: 26px; height: 26px; border-radius: 50%; overflow: hidden; flex-shrink: 0; margin-top: 2px; background: var(--surface-2); }
.msg-avatar img { width: 100%; height: 100%; object-fit: cover; display: block; }
.msg-avatar-me {
  width: 26px; height: 26px; border-radius: 50%; background: var(--surface-3);
  border: 1px solid var(--border-2); display: flex; align-items: center; justify-content: center;
  font-size: 11px; flex-shrink: 0; margin-top: 2px; color: var(--ink-3);
}

.msg-body { flex: 1; max-width: 520px; }
.msg-inner.me .msg-body { display: flex; flex-direction: column; align-items: flex-end; }

.bubble {
  display: inline-block; padding: 10px 14px; border-radius: var(--r-lg);
  font-size: 14px; line-height: 1.65; max-width: 100%; word-break: break-word;
}
.bubble-mia { background: var(--surface); border: 1px solid var(--border); border-top-left-radius: 4px; color: var(--ink); }
.bubble-me  { background: var(--surface-3); border: 1px solid var(--border-2); border-top-right-radius: 4px; color: var(--ink); }

/* Sources */
.msg-sources { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 8px; }
.src-chip {
  display: inline-flex; align-items: center; gap: 4px;
  font-size: 10.5px; color: var(--teal); text-decoration: none;
  background: var(--teal-dim); border: 1px solid rgba(56,180,200,0.12);
  border-radius: 999px; padding: 2px 9px;
  transition: all 0.15s;
  font-family: 'SF Mono', 'Cascadia Code', Consolas, monospace; letter-spacing: 0.02em;
}
.src-chip:hover { background: rgba(56,180,200,0.16); border-color: rgba(56,180,200,0.28); }
.src-chip .dot { font-size: 7px; opacity: 0.55; }

/* Quick links */
.msg-qlinks { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 6px; }
.ql-btn {
  display: inline-flex; align-items: center; gap: 4px;
  font-size: 11px; font-weight: 500; color: var(--accent); text-decoration: none;
  background: var(--accent-dim); border: 1px solid var(--border-acc);
  border-radius: var(--r-sm); padding: 3px 10px; transition: all 0.15s; letter-spacing: 0.01em;
}
.ql-btn:hover { background: rgba(240,100,74,0.2); }
.ql-arrow { width: 10px; height: 10px; flex-shrink: 0; opacity: 0.65; }

/* Typing */
.typing-row { padding: 3px 24px; margin-top: 10px; }
.typing-inner { display: flex; gap: 10px; }
.typing-bubble {
  display: inline-flex; align-items: center; gap: 4px; padding: 10px 14px;
  background: var(--surface); border: 1px solid var(--border);
  border-radius: var(--r-lg); border-top-left-radius: 4px;
}
.td { width: 5px; height: 5px; border-radius: 50%; background: var(--ink-3); animation: td 1.2s ease infinite; }
.td:nth-child(2) { animation-delay: 0.12s; }
.td:nth-child(3) { animation-delay: 0.24s; }
@keyframes td { 0%,60%,100% { transform: translateY(0); opacity: 0.25; } 30% { transform: translateY(-4px); opacity: 1; } }

/* ─── Empty state ────────────────────────────────────────────────────────────── */
.empty {
  flex: 1; display: flex; flex-direction: column; align-items: center;
  justify-content: center; gap: 18px; padding: 20px 40px; text-align: center;
}
.empty-avatar { position: relative; width: 60px; height: 60px; }
.empty-halo {
  position: absolute; inset: -3px; border-radius: 50%;
  background: conic-gradient(from 0deg, #F0644A, #F5A462, #E8C96D, #F5A462, #F0644A);
  animation: halo-turn 10s linear infinite; opacity: 0.7;
}
.empty-img { position: absolute; inset: 3px; border-radius: 50%; overflow: hidden; }
.empty-img img { width: 100%; height: 100%; object-fit: cover; filter: saturate(0.88); display: block; }
.empty-h { font-size: 18px; font-weight: 700; letter-spacing: -0.01em; color: var(--ink); text-wrap: balance; }
.empty-p { font-size: 13px; color: var(--ink-2); max-width: 340px; line-height: 1.65; text-wrap: balance; }

.starters { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; width: 100%; max-width: 460px; }
.starter {
  background: var(--surface); border: 1px solid var(--border);
  border-radius: var(--r-md); padding: 10px 13px;
  text-align: left; cursor: pointer; transition: background 0.15s, border-color 0.15s;
}
.starter:hover { background: var(--surface-2); border-color: var(--border-2); }
.starter-label { font-size: 12px; color: var(--ink); font-weight: 500; line-height: 1.4; display: block; }
.starter-sub { font-size: 10px; color: var(--ink-3); display: block; margin-top: 1px; }

/* ─── Input ──────────────────────────────────────────────────────────────────── */
.input-area { flex-shrink: 0; padding: 0 20px 20px; }
.input-shell {
  background: var(--surface); border: 1px solid var(--border-2);
  border-radius: var(--r-xl); overflow: hidden;
  transition: border-color 0.2s, box-shadow 0.2s;
}
.input-shell:focus-within {
  border-color: var(--border-acc);
  box-shadow: 0 0 0 3px rgba(240,100,74,0.07);
}
.input-field {
  width: 100%; background: transparent; border: none; outline: none;
  padding: 14px 18px 6px; color: var(--ink); font-size: 14px; font-family: inherit;
  line-height: 1.6; resize: none; min-height: 48px; max-height: 130px; display: block;
}
.input-field::placeholder { color: var(--ink-3); }
.input-toolbar { display: flex; align-items: center; padding: 6px 10px 10px; gap: 4px; }
.toolbar-hint {
  font-size: 10px; color: var(--ink-3); margin-right: auto; padding-left: 6px;
  font-family: 'SF Mono', Consolas, monospace; letter-spacing: 0.03em;
}
.ibutton {
  width: 30px; height: 30px; border-radius: var(--r-sm);
  border: 1px solid var(--border); background: transparent; color: var(--ink-3);
  display: flex; align-items: center; justify-content: center; font-size: 14px;
  cursor: pointer; transition: all 0.15s;
}
.ibutton:hover { background: var(--surface-2); color: var(--ink-2); border-color: var(--border-2); }
.ibutton.active { background: var(--accent-dim); color: var(--accent); border-color: var(--border-acc); }
.btn-send {
  height: 30px; padding: 0 14px; border-radius: var(--r-sm);
  background: var(--accent); border: none; color: #fff;
  font-size: 12px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase;
  cursor: pointer; transition: background 0.15s, transform 0.1s, box-shadow 0.15s;
  display: flex; align-items: center; gap: 5px;
}
.btn-send:hover { background: #e05840; box-shadow: 0 2px 12px rgba(240,100,74,0.35); transform: translateY(-1px); }
.btn-send:active { transform: translateY(0); }
.btn-send:disabled { opacity: 0.38; cursor: not-allowed; box-shadow: none; transform: none; }

/* ─── Responsive ─────────────────────────────────────────────────────────────── */
@media (max-width: 700px) {
  .app { grid-template-columns: 1fr; }
  .sidebar { display: none; }
  .msg-row { padding: 3px 14px; }
  .typing-row { padding: 3px 14px; }
  .input-area { padding: 0 12px 16px; }
  .empty { padding: 20px; }
  .starters { grid-template-columns: 1fr; }
  .chat-topbar { padding: 0 16px; }
}
</style>

